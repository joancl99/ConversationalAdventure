<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.adventure.ui.fx.GameOverController"
      alignment="CENTER" spacing="0"
      style="-fx-background-color: #0d1117;">

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Death icon -->
    <Label text="☠"
           style="-fx-font-size: 64; -fx-text-fill: #cf222e;
                  -fx-effect: dropshadow(gaussian, #cf222e, 20, 0.4, 0, 0);"/>

    <!-- Title -->
    <Label text="YOU DIED"
           style="-fx-font-size: 56; -fx-font-weight: bold; -fx-font-family: Georgia;
                  -fx-text-fill: #cf222e;
                  -fx-effect: dropshadow(gaussian, #8b0000, 12, 0.3, 0, 0);
                  -fx-padding: 8 0 0 0;"/>

    <!-- Divider -->
    <HBox alignment="CENTER" style="-fx-padding: 20 0 20 0;">
        <Separator prefWidth="280" style="-fx-background-color: #30363d;"/>
    </HBox>

    <!-- Stats -->
    <Label fx:id="lblWins"
           style="-fx-font-size: 15; -fx-text-fill: #6e7681;"/>

    <Label fx:id="lblClass"
           style="-fx-font-size: 18; -fx-font-weight: bold;
                  -fx-padding: 6 0 0 0;"/>

    <Region prefHeight="36"/>

    <!-- Buttons -->
    <Button text="NEW GAME" onAction="#onNewGame"
            prefWidth="200" prefHeight="46"
            style="-fx-font-size: 14; -fx-font-weight: bold;
                   -fx-background-color: #238636; -fx-text-fill: #ffffff;
                   -fx-background-radius: 8; -fx-cursor: hand;"/>

    <Region prefHeight="12"/>

    <Button text="Back to Menu" onAction="#onBackToMenu"
            prefWidth="200" prefHeight="40"
            style="-fx-font-size: 13;
                   -fx-background-color: transparent; -fx-text-fill: #6e7681;
                   -fx-cursor: hand;
                   -fx-border-color: #30363d; -fx-border-radius: 8; -fx-border-width: 1;
                   -fx-background-radius: 8;"/>

    <Region VBox.vgrow="ALWAYS"/>

</VBox>
