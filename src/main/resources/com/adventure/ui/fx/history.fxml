<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.adventure.ui.fx.HistoryController"
            style="-fx-background-color: #0d1117;">

    <!-- ── HEADER ─────────────────────────────────────────────────────────── -->
    <top>
        <VBox style="-fx-background-color: #161b22;
                     -fx-border-color: #30363d; -fx-border-width: 0 0 1 0;">

            <HBox alignment="CENTER_LEFT" spacing="16"
                  style="-fx-padding: 16 24 14 24;">

                <Button text="← volver" onAction="#onBack"
                        prefHeight="34"
                        style="-fx-font-size: 12; -fx-font-weight: bold;
                               -fx-background-color: transparent; -fx-text-fill: #6e7681;
                               -fx-cursor: hand;
                               -fx-border-color: #30363d; -fx-border-radius: 6; -fx-border-width: 1;
                               -fx-background-radius: 6; -fx-padding: 4 14;"/>

                <VBox spacing="2">
                    <Label text="HISTORIAL DE LA AVENTURA"
                           style="-fx-font-size: 17; -fx-font-weight: bold;
                                  -fx-text-fill: #e6edf3; -fx-font-family: Georgia;"/>
                    <Label text="RIVERLAND · Crónica de tu viaje"
                           style="-fx-font-size: 11; -fx-text-fill: #6e7681;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblEntryCount"
                       style="-fx-font-size: 11; -fx-text-fill: #6e7681;
                              -fx-background-color: #21262d;
                              -fx-background-radius: 12; -fx-padding: 4 10;"/>

            </HBox>

        </VBox>
    </top>

    <!-- ── CONTENT ────────────────────────────────────────────────────────── -->
    <center>
        <ScrollPane fx:id="scrollHistory" fitToWidth="true" pannable="false"
                    style="-fx-background-color: #0d1117;
                           -fx-background: #0d1117;
                           -fx-border-width: 0;">
            <VBox fx:id="historyBox" spacing="0"
                  style="-fx-padding: 28 40 40 40; -fx-background-color: #0d1117;"/>
        </ScrollPane>
    </center>

</BorderPane>
