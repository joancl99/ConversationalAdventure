<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.adventure.ui.fx.HistoryController">

    <!-- ── HEADER ─────────────────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="world-header">

            <Button text="← volver" onAction="#onBack" styleClass="btn-ghost"/>

            <VBox spacing="2">
                <Label text="HISTORIAL DE LA AVENTURA"   styleClass="title-page"/>
                <Label text="RIVERLAND · Crónica de tu viaje" styleClass="title-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblEntryCount" styleClass="text-progress-label"/>

        </HBox>
    </top>

    <!-- ── CONTENT ────────────────────────────────────────────────────────── -->
    <center>
        <ScrollPane fx:id="scrollHistory" fitToWidth="true" pannable="false">
            <VBox fx:id="historyBox" spacing="0">
                <padding>
                    <Insets top="32" right="48" bottom="40" left="48"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
