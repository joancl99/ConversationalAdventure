<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.adventure.ui.fx.ClassSelectController"
      alignment="CENTER" spacing="28"
      style="-fx-background-color: #0d1117; -fx-padding: 40;">

    <!-- Title -->
    <Label text="Choose Your Class"
           style="-fx-font-size: 32; -fx-font-weight: bold;
                  -fx-text-fill: #f0c040; -fx-font-family: Georgia;"/>
    <Label text="Each class plays differently. Choose wisely."
           style="-fx-font-size: 14; -fx-text-fill: #6e7681;"/>

    <!-- Class cards -->
    <HBox alignment="CENTER" spacing="20">

        <!-- WARRIOR -->
        <VBox alignment="CENTER" spacing="14" prefWidth="215"
              style="-fx-background-color: #161b22; -fx-padding: 28;
                     -fx-background-radius: 12;
                     -fx-border-color: #f0c040; -fx-border-radius: 12; -fx-border-width: 1;">
            <Label text="WARRIOR"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f0c040;"/>
            <Separator style="-fx-background-color: #30363d;"/>
            <GridPane hgap="24" vgap="6">
                <Label text="HP"      style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="200"     style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Attack"  style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="75"      style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Speed"   style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="4.5"     style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
            <Label text="Tank. High HP, steady damage, slower speed."
                   wrapText="true" prefWidth="160" textAlignment="CENTER"
                   style="-fx-text-fill: #6e7681; -fx-font-size: 12;"/>
            <Button text="Select" onAction="#onSelectWarrior"
                    prefWidth="150" prefHeight="40"
                    style="-fx-font-size: 14; -fx-font-weight: bold;
                           -fx-background-color: #f0c040; -fx-text-fill: #0d1117;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>

        <!-- MAGE -->
        <VBox alignment="CENTER" spacing="14" prefWidth="215"
              style="-fx-background-color: #161b22; -fx-padding: 28;
                     -fx-background-radius: 12;
                     -fx-border-color: #58a6ff; -fx-border-radius: 12; -fx-border-width: 1;">
            <Label text="MAGE"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>
            <Separator style="-fx-background-color: #30363d;"/>
            <GridPane hgap="24" vgap="6">
                <Label text="HP"      style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="75"      style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Attack"  style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="100"     style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Speed"   style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="6.5"     style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
            <Label text="Balanced. Good damage, moderate HP and speed."
                   wrapText="true" prefWidth="160" textAlignment="CENTER"
                   style="-fx-text-fill: #6e7681; -fx-font-size: 12;"/>
            <Button text="Select" onAction="#onSelectMage"
                    prefWidth="150" prefHeight="40"
                    style="-fx-font-size: 14; -fx-font-weight: bold;
                           -fx-background-color: #58a6ff; -fx-text-fill: #0d1117;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>

        <!-- ROGUE -->
        <VBox alignment="CENTER" spacing="14" prefWidth="215"
              style="-fx-background-color: #161b22; -fx-padding: 28;
                     -fx-background-radius: 12;
                     -fx-border-color: #bc8cff; -fx-border-radius: 12; -fx-border-width: 1;">
            <Label text="ROGUE"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #bc8cff;"/>
            <Separator style="-fx-background-color: #30363d;"/>
            <GridPane hgap="24" vgap="6">
                <Label text="HP"      style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="50"      style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Attack"  style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="150"     style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Speed"   style="-fx-text-fill: #6e7681; -fx-font-size: 13;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="8.5"     style="-fx-text-fill: #e6edf3; -fx-font-size: 13;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
            <Label text="Glass cannon. Extreme speed and damage, very low HP."
                   wrapText="true" prefWidth="160" textAlignment="CENTER"
                   style="-fx-text-fill: #6e7681; -fx-font-size: 12;"/>
            <Button text="Select" onAction="#onSelectRogue"
                    prefWidth="150" prefHeight="40"
                    style="-fx-font-size: 14; -fx-font-weight: bold;
                           -fx-background-color: #bc8cff; -fx-text-fill: #0d1117;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>

    </HBox>

    <!-- Back -->
    <Button text="Back to Menu" onAction="#onBack"
            prefWidth="160" prefHeight="36"
            style="-fx-font-size: 13;
                   -fx-background-color: transparent; -fx-text-fill: #6e7681;
                   -fx-cursor: hand;
                   -fx-border-color: #30363d; -fx-border-radius: 6; -fx-border-width: 1;
                   -fx-background-radius: 6;"/>

</VBox>
