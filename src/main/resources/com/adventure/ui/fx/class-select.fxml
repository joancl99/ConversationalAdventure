<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.adventure.ui.fx.ClassSelectController"
      alignment="CENTER" spacing="0"
      prefWidth="800" prefHeight="600">

    <Region prefHeight="32" minHeight="32"/>

    <!-- ── Title ───────────────────────────────────────────────────── -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="CHOOSE YOUR CLASS" styleClass="title-section"/>
        <Label text="the path you choose cannot be unmade" styleClass="title-subtitle"/>
    </VBox>

    <Region prefHeight="20" minHeight="20"/>

    <!-- ── Ornamental divider: ─── ❦ ─── ───────────────────────────── -->
    <HBox alignment="CENTER" spacing="14">
        <Region styleClass="divider-line" prefWidth="60" maxWidth="60"/>
        <Label text="❦" styleClass="divider-ornament"/>
        <Region styleClass="divider-line" prefWidth="60" maxWidth="60"/>
    </HBox>

    <Region prefHeight="26" minHeight="26"/>

    <!-- ── Class cards ─────────────────────────────────────────────── -->
    <HBox alignment="CENTER" spacing="20">

        <!-- WARRIOR -->
        <VBox styleClass="panel-warrior" alignment="CENTER" spacing="14" prefWidth="225">
            <Label text="WARRIOR" styleClass="card-title, text-warrior"/>
            <Separator/>
            <GridPane hgap="28" vgap="6">
                <Label text="HP"     styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="200"    styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="ATTACK" styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="75"     styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="SPEED"  styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="4.5"    styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
            <Separator/>
            <Label text="Tank. High HP, steady damage, slower speed."
                   styleClass="card-description"
                   wrapText="true" prefWidth="175" textAlignment="CENTER"/>
            <Button text="SELECT" onAction="#onSelectWarrior"
                    styleClass="btn-warrior" prefWidth="160"/>
        </VBox>

        <!-- MAGE -->
        <VBox styleClass="panel-mage" alignment="CENTER" spacing="14" prefWidth="225">
            <Label text="MAGE" styleClass="card-title, text-mage"/>
            <Separator/>
            <GridPane hgap="28" vgap="6">
                <Label text="HP"     styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="75"     styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="ATTACK" styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="100"    styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="SPEED"  styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="6.5"    styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
            <Separator/>
            <Label text="Balanced. Good damage, moderate HP and speed."
                   styleClass="card-description"
                   wrapText="true" prefWidth="175" textAlignment="CENTER"/>
            <Button text="SELECT" onAction="#onSelectMage"
                    styleClass="btn-mage" prefWidth="160"/>
        </VBox>

        <!-- ROGUE -->
        <VBox styleClass="panel-rogue" alignment="CENTER" spacing="14" prefWidth="225">
            <Label text="ROGUE" styleClass="card-title, text-rogue"/>
            <Separator/>
            <GridPane hgap="28" vgap="6">
                <Label text="HP"     styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="50"     styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="ATTACK" styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="150"    styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="SPEED"  styleClass="text-stat-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="8.5"    styleClass="text-stat-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
            <Separator/>
            <Label text="Glass cannon. Extreme speed and damage, very low HP."
                   styleClass="card-description"
                   wrapText="true" prefWidth="175" textAlignment="CENTER"/>
            <Button text="SELECT" onAction="#onSelectRogue"
                    styleClass="btn-rogue" prefWidth="160"/>
        </VBox>

    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- ── Back ────────────────────────────────────────────────────── -->
    <Button text="← back to the threshold" onAction="#onBack"
            styleClass="btn-ghost"/>

    <Region prefHeight="20" minHeight="20"/>

</VBox>
