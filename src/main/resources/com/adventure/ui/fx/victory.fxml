<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.adventure.ui.fx.VictoryController"
      alignment="CENTER" spacing="0"
      style="-fx-background-color: #0d1117;">

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Victory icon -->
    <Label text="★"
           style="-fx-font-size: 72; -fx-text-fill: #f0c040;
                  -fx-effect: dropshadow(gaussian, #f0c040, 24, 0.5, 0, 0);"/>

    <!-- Title -->
    <Label text="VICTORY"
           style="-fx-font-size: 56; -fx-font-weight: bold; -fx-font-family: Georgia;
                  -fx-text-fill: #f0c040;
                  -fx-effect: dropshadow(gaussian, #a07800, 14, 0.4, 0, 0);
                  -fx-padding: 8 0 0 0;"/>

    <Label text="RIVERLAND is saved."
           style="-fx-font-size: 16; -fx-font-style: italic; -fx-text-fill: #9a8560;
                  -fx-padding: 10 0 0 0;"/>

    <!-- Divider -->
    <HBox alignment="CENTER" style="-fx-padding: 20 0 20 0;">
        <Separator prefWidth="280" style="-fx-background-color: #30363d;"/>
    </HBox>

    <!-- Stats -->
    <Label fx:id="lblClass"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <Label fx:id="lblWins"
           style="-fx-font-size: 14; -fx-text-fill: #6e7681; -fx-padding: 6 0 0 0;"/>

    <Region prefHeight="36"/>

    <!-- Button -->
    <Button text="BACK TO MENU" onAction="#onBackToMenu"
            prefWidth="200" prefHeight="46"
            style="-fx-font-size: 14; -fx-font-weight: bold;
                   -fx-background-color: #f0c040; -fx-text-fill: #0d1117;
                   -fx-background-radius: 8; -fx-cursor: hand;"/>

    <Region VBox.vgrow="ALWAYS"/>

</VBox>
