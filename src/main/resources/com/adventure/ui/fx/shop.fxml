<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.adventure.ui.fx.ShopController"
            style="-fx-background-color: #0d1117;">

    <!-- ── TOP: header ─────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #161b22;
                     -fx-border-color: #30363d; -fx-border-width: 0 0 1 0;
                     -fx-padding: 14 24;">

            <Label text="🛒"
                   style="-fx-font-size: 20;"/>

            <Label text="MERCHANT"
                   style="-fx-font-size: 20; -fx-font-weight: bold;
                          -fx-font-family: Georgia; -fx-text-fill: #f0c040;"/>

            <Label fx:id="lblTierBadge"
                   style="-fx-font-size: 11; -fx-font-weight: bold;
                          -fx-padding: 3 8; -fx-background-radius: 4;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblCoinsHeader"
                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #f0c040;"/>

        </HBox>
    </top>

    <!-- ── CENTER: shop content ─────────────────────────────────────── -->
    <center>
        <ScrollPane fitToWidth="true" pannable="false"
                    style="-fx-background-color: #0d1117; -fx-background: #0d1117;
                           -fx-border-width: 0;">
            <VBox spacing="0" style="-fx-padding: 24;">

                <!-- Potions section -->
                <Label text="POTIONS"
                       style="-fx-font-size: 11; -fx-text-fill: #6e7681;
                              -fx-padding: 0 0 10 0;"/>

                <HBox spacing="12">
                    <Button fx:id="btnHeal" onAction="#onBuyHeal"
                            prefHeight="52"
                            style="-fx-font-size: 13; -fx-font-weight: bold;
                                   -fx-background-color: #238636; -fx-text-fill: #ffffff;
                                   -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-padding: 0 20;"/>

                    <Button fx:id="btnDmg" onAction="#onBuyDmg"
                            prefHeight="52"
                            style="-fx-font-size: 13; -fx-font-weight: bold;
                                   -fx-background-color: #8b2fc9; -fx-text-fill: #ffffff;
                                   -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-padding: 0 20;"/>
                </HBox>

                <Separator style="-fx-background-color: #30363d; -fx-padding: 20 0;"/>

                <!-- Items section (populated dynamically) -->
                <VBox fx:id="itemsSection" spacing="0"/>

                <!-- Feedback -->
                <Label fx:id="lblFeedback"
                       wrapText="true"
                       style="-fx-font-size: 13; -fx-text-fill: transparent;
                              -fx-padding: 16 0 0 0;"/>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ── BOTTOM: status + leave ───────────────────────────────────── -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #161b22;
                     -fx-border-color: #30363d; -fx-border-width: 1 0 0 0;
                     -fx-padding: 16 24;">

            <VBox spacing="4">
                <Label fx:id="lblCoinsStatus"
                       style="-fx-font-size: 13; -fx-text-fill: #f0c040;"/>
                <Label fx:id="lblPotionsStatus"
                       style="-fx-font-size: 12; -fx-text-fill: #6e7681;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="LEAVE" onAction="#onLeave"
                    prefWidth="120" prefHeight="42"
                    style="-fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: transparent; -fx-text-fill: #6e7681;
                           -fx-cursor: hand;
                           -fx-border-color: #30363d; -fx-border-radius: 8; -fx-border-width: 1;
                           -fx-background-radius: 8;"/>

        </HBox>
    </bottom>

</BorderPane>
