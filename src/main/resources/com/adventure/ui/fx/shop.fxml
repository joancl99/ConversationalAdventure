<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.adventure.ui.fx.ShopController">

    <!-- ── TOP: header ─────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="world-header">

            <Label text="🛒"     styleClass="title-wordmark"/>
            <Label text="MERCHANT" styleClass="title-page"/>
            <Label fx:id="lblTierBadge" styleClass="tier-chip"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblCoinsHeader" styleClass="text-coin-large"/>

        </HBox>
    </top>

    <!-- ── CENTER: shop content ─────────────────────────────────────── -->
    <center>
        <ScrollPane fitToWidth="true" pannable="false">
            <VBox spacing="0">
                <padding>
                    <Insets top="28" right="32" bottom="32" left="32"/>
                </padding>

                <!-- Potions section -->
                <Label text="POTIONS" styleClass="section-label"/>

                <HBox spacing="14">
                    <Button fx:id="btnHeal" onAction="#onBuyHeal" prefHeight="50" styleClass="btn-heal"/>
                    <Button fx:id="btnDmg"  onAction="#onBuyDmg"  prefHeight="50" styleClass="btn-buff"/>
                </HBox>

                <Separator>
                    <VBox.margin>
                        <Insets top="22" bottom="22"/>
                    </VBox.margin>
                </Separator>

                <!-- Items section (populated dynamically) -->
                <VBox fx:id="itemsSection" spacing="0"/>

                <!-- Feedback -->
                <Label fx:id="lblFeedback" wrapText="true"/>

            </VBox>
        </ScrollPane>
    </center>

    <!-- ── BOTTOM: status + leave ───────────────────────────────────── -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="world-footer">

            <VBox spacing="4">
                <Label fx:id="lblCoinsStatus"   styleClass="text-coin-large"/>
                <Label fx:id="lblPotionsStatus" styleClass="text-progress-label"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="LEAVE" onAction="#onLeave" prefWidth="140" styleClass="btn-secondary"/>

        </HBox>
    </bottom>

</BorderPane>
