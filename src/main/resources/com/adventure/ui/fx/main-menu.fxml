<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.adventure.ui.fx.MainMenuController"
      alignment="CENTER" spacing="0"
      prefWidth="800" prefHeight="600">

    <Region VBox.vgrow="ALWAYS"/>

    <!-- ── Title block ─────────────────────────────────────────────── -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="RIVERLAND" styleClass="title-display"/>
        <Label text="a chronicle of the river lands" styleClass="title-subtitle"/>
    </VBox>

    <Region prefHeight="34" minHeight="34"/>

    <!-- ── Ornamental divider: ─── ❦ ─── ───────────────────────────── -->
    <HBox alignment="CENTER" spacing="16">
        <Region styleClass="divider-line" prefWidth="80" maxWidth="80"/>
        <Label text="❦" styleClass="divider-ornament"/>
        <Region styleClass="divider-line" prefWidth="80" maxWidth="80"/>
    </HBox>

    <Region prefHeight="38" minHeight="38"/>

    <!-- ── Action stack ────────────────────────────────────────────── -->
    <VBox alignment="CENTER" spacing="14">
        <Button fx:id="btnNewGame"  text="NEW GAME"  onAction="#onNewGame"
                styleClass="btn-primary"   prefWidth="240"/>
        <Button fx:id="btnContinue" text="CONTINUE"  onAction="#onContinue"
                styleClass="btn-secondary" prefWidth="240"/>
        <Button fx:id="btnExit"     text="depart"    onAction="#onExit"
                styleClass="btn-ghost"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- ── Footer mark ─────────────────────────────────────────────── -->
    <Label text="⁂   writ in moss &amp; gold leaf   ⁂"
           styleClass="title-subtitle"
           style="-fx-font-size: 12; -fx-padding: 0 0 18 0;"/>

</VBox>
